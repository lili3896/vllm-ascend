      "id": "g-apply-t",
      "type": "text",
      "x": 260,
      "y": 1520,
      "width": 500,
      "height": 130,
      "text": "load b_g [BT]      g_ptr = g + bos + i_h * T_max\n(注意: 用 T_max 而非本序列 T, 因 g 已 [B,H,T] 连续布局)\nb_o *= exp(b_g)[:, None]                 # 累计衰减乘到 inter-chunk\nb_A *= safe_exp(b_g[:,None] - b_g[None,:]) # j->i 衰减乘到 QK 分数",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 10,
      "containerId": "g-apply",
      "originalText": "load b_g [BT]      g_ptr = g + bos + i_h * T_max\n(注意: 用 T_max 而非本序列 T, 因 g 已 [B,H,T] 连续布局)\nb_o *= exp(b_g)[:, None]                 # 累计衰减乘到 inter-chunk\nb_A *= safe_exp(b_g[:,None] - b_g[None,:]) # j->i 衰减乘到 QK 分数",
